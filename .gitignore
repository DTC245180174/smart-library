# 1. Môi trường & Bí mật (CỰC KỲ QUAN TRỌNG - KHÔNG ĐƯỢC LỘ)
.env
.env.*
!.env.example

# 2. Chứng chỉ số SSL & Khóa bảo mật (Tránh lộ private key)
nginx/certs/
*.key
*.crt
*.pem
*.csr

# 3. Thư mục Agent / IDE cấu hình riêng
.agent/
.agents/
agent/
.vscode/
.idea/

# 4. Dữ liệu CSDL cục bộ (nếu có mount ra ngoài)
mysql_data/
data/

# 5. Python backend artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.venv/
venv/
env/

# 6. Node / Frontend artifacts
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. OS generated files
.DS_Store
Thumbs.db

# Exporter config chứa mật khẩu
mysqld_exporter/.my.cnf
*.cnf
!*.cnf.example
