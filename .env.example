# =================================================================
# SMARTLIB - CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# =================================================================

# Cấu hình Máy chủ Backend (FastAPI / Uvicorn)
PORT=3000
HOST=0.0.0.0
ENV=development

# -----------------------------------------------------------------
# CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL 8.0 (CHUẨN 3NF)
# -----------------------------------------------------------------
DB_ENGINE=mysql

# Thông số kết nối MySQL (Dành cho XAMPP, Laragon, MySQL Server hoặc Docker)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=smartlib_db

# -----------------------------------------------------------------
# CẤU HÌNH TRỢ LÝ AI THÔNG MINH (GOOGLE GEMINI API / OPENAI)
# -----------------------------------------------------------------
# Lấy Google Gemini API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# Cấu hình Frontend (React Vite)
VITE_API_URL=http://localhost:3000/api
